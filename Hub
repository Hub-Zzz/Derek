g.Name="mini" g.ResetOnSpawn=false
local f=Instance.new("Frame",g) f.Size=UDim2.fromOffset(150,300) f.Position=UDim2.new(0,10,.5,-150)
f.BackgroundColor3=Color3.fromRGB(18,20,26) f.BorderSizePixel=0 f.Visible=false
Instance.new("UICorner",f).CornerRadius=UDim.new(0,10)
local l=Instance.new("UIListLayout",f) l.Padding=UDim.new(0,4) l.HorizontalAlignment=Enum.HorizontalAlignment.Center
Instance.new("UIPadding",f).PaddingTop=UDim.new(0,8)
local bub=Instance.new("TextButton",g) bub.Size=UDim2.fromOffset(46,46) bub.Position=UDim2.new(0,10,.5,-23)
bub.BackgroundColor3=Color3.fromRGB(25,28,36) bub.Text="MVS" bub.TextColor3=Color3.fromRGB(90,220,255)
bub.Font=Enum.Font.GothamBold bub.TextSize=13 Instance.new("UICorner",bub).CornerRadius=UDim.new(1,0)
bub.MouseButton1Click:Connect(function() f.Visible=not f.Visible bub.Visible=not f.Visible end)

for k,v in pairs({aim="Aimbot",silent="Silent Aim",esp="ESP",hb="Hitbox",spd="Speed",fly="Fly",ij="Inf Jump",bypass="Bypass"}) do
  local b=Instance.new("TextButton",f) b.Size=UDim2.new(1,-12,0,30) b.BackgroundColor3=Color3.fromRGB(32,36,46)
  b.Text=v b.Font=Enum.Font.Gotham b.TextSize=13 b.TextColor3=Color3.fromRGB(210,215,225) b.BorderSizePixel=0
  Instance.new("UICorner",b).CornerRadius=UDim.new(0,7)
  local function r() b.BackgroundColor3=F[k] and Color3.fromRGB(45,130,220) or Color3.fromRGB(32,36,46) end
  b.MouseButton1Click:Connect(function() F[k]=not F[k] r()
    if k=="esp" then esp(F.esp) elseif k=="hb" then hb(F.hb) end end)
  r()
end
U.InputBegan:Connect(function(i) if i.KeyCode==Enum.KeyCode.RightShift then
  f.Visible=not f.Visible bub.Visible=not f.Visible end end)
